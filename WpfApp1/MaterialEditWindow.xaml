<Window x:Class="WpfApp1.MaterialEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MaterialEditWindow" Height="600" Width="800" Background="#FFFFFF" FontFamily="Georgia">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Добавление материала" FontSize="20" FontWeight="Bold" Foreground="#8A5A44" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Тип материала:" Margin="0,0,0,5"/>
            <ComboBox x:Name="MaterialTypeComboBox" DisplayMemberPath="MaterialTypeName" SelectedValuePath="MaterialTypeId" Height="30" Margin="0,0,0,15"/>
            <TextBlock Text="Наименование:" Margin="0,0,0,5"/>
            <TextBox x:Name="NameTextBox" Height="30" Margin="0,0,0,15" Padding="5"/>
            <TextBlock Text="Цена единицы:" Margin="0,0,0,5"/>
            <TextBox x:Name="PriceTextBox" Height="30" Margin="0,0,0,15" Padding="5"/>
            <TextBlock Text="Единица измерения:" Margin="0,0,0,5"/>
            <TextBox x:Name="UnitTextBox" Height="30" Margin="0,0,0,15" Padding="5"/>
            <TextBlock Text="Количество в упаковке:" Margin="0,0,0,5"/>
            <TextBox x:Name="PackageQuantityTextBox" Height="30" Margin="0,0,0,15" Padding="5"/>
            <TextBlock Text="Количество на складе:" Margin="0,0,0,5"/>
            <TextBox x:Name="StockQuantityTextBox" Height="30" Margin="0,0,0,15" Padding="5"/>
            <TextBlock Text="Минимальное количество:" Margin="0,0,0,5"/>
            <TextBox x:Name="MinQuantityTextBox" Height="30" Margin="0,0,0,15" Padding="5"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Назад" Grid.Column="0" Height="40" Margin="0,0,10,0" Background="#F4E6D4" Foreground="#8A5A44" FontWeight="Bold" BorderThickness="0" Click="CancelButton_Click"/>
            <Button Content="Сохранить" Grid.Column="1" Height="40" Background="#8A5A44" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
